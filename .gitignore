# ============================================================
# AudioTS — 仓库纯净策略
# 允许提交（白名单）：src/** 源码 + 构建/部署必需配置 + LICENSE + README.md
#   · 构建/部署必需：package.json / package-lock.json / tsconfig*.json /
#     vite.config.ts / index.html / version.json / public/_headers
# 其余一切（文档、设计产物、模型、缓存、日志、本地配置、依赖残留）
# 一律不提交，无论分支。
# ============================================================

# Dependencies
node_modules/

# Build output / auto-generated
dist/
build/
*.tsbuildinfo
vite.config.d.ts

# Environment (local dev switch only, never committed)
.env
.env.*
!.env.example

# IDE / Editor
.vscode/
.idea/
*.swp
*.swo
*.bak
*.orig
*~

# OS
.DS_Store
Thumbs.db
desktop.ini

# === 模型文件 — 不随代码分发 ===
# 用户需自行从 HuggingFace 下载 VoiceDesign 模型集
# See: Models/DOWNLOAD_GUIDE.md
Models/

# Python cache
__pycache__/
*.pyc

# Agent workspace (project data, not source)
.workbuddy/

# Audio / numpy artifacts (local only, not in repo)
*.wav
*.npy

# Dev servers — CPages static hosting only, no local servers in repo
server.cjs
server.mjs

# Project documentation / design deliverables (local only)
docs/
deliverables/

# Project planning / old session artifacts
overview.md
离线前端配音系统开发实施计划.md

# Test runner config — local only, not needed for CPages build
# 注意：src/**/__tests__/ 属源码（回归测试），仍纳入跟踪
vitest.config.ts
src/__tests__/

# Logs / caches
*.log
logs/
coverage/
.cache/
.vite/
.eslintcache

# Archives — 交付打包产物仅存本地
*.zip
*.tar.gz

# Scratch / temp / probe files
.tmp_probe/
_chk*
